# --- Auth (single-user MVP) ---
# HMAC signing key for JWT access + refresh tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# The one permitted username for MVP.
ADMIN_USERNAME=me

# argon2 hash of the admin password.
# Generate with: cargo run -p api --bin hash-password -- 'yourpassword'
ADMIN_PASSWORD_HASH=

# Access token lifetime in seconds (default 900 = 15 min).
ACCESS_TOKEN_TTL_SECS=900

# Refresh token lifetime in seconds (default 2592000 = 30 days).
REFRESH_TOKEN_TTL_SECS=2592000

# --- Database ---
DATABASE_URL=postgres://grind75:dev_password@localhost:5432/grind75_dev
POSTGRES_DB=grind75_dev
POSTGRES_USER=grind75
POSTGRES_PASSWORD=dev_password

# --- Server ---
API_HOST=127.0.0.1
API_PORT=3001
RUST_LOG=info,api=debug

# --- Web ---
API_URL=http://127.0.0.1:3001
ORIGIN=http://localhost:5173
